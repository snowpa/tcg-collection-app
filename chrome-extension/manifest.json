{
  "manifest_version": 3,
  "name": "トレカ・コレクション カードラッシュ連携",
  "version": "1.0.0",
  "description": "トレカ・コレクション（Webアプリ）から、カードラッシュのカード名・画像を検索できるようにします。",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "host_permissions": ["https://www.cardrush-pokemon.jp/*"],
  "externally_connectable": {
    "matches": ["https://snowpa.github.io/*", "http://localhost/*", "http://127.0.0.1/*"]
  }
}
